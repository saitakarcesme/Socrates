{
  "name": "@socrates/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-development": "tsx src/seed-development.ts",
    "lint": "eslint src",
    "test": "drizzle-kit check && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.drizzle.json"
  },
  "dependencies": {
    "@socrates/artifact-store": "workspace:*",
    "@socrates/contracts": "workspace:*",
    "@socrates/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1"
  }
}
