{
  "name": "@socrates/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs && node smoke.mjs",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src",
    "runner:token:provision": "tsx src/provision-runner-token.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/standard-validator": "^0.3.0",
    "@socrates/artifact-store": "workspace:*",
    "@socrates/contracts": "workspace:*",
    "@socrates/database": "workspace:*",
    "@socrates/domain": "workspace:*",
    "@socrates/runner-auth": "workspace:*",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.20.3"
  }
}
